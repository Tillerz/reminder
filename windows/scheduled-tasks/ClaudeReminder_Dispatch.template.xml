<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Placeholders COMPUTER\WindowsUser, the SID and the path must be
     replaced with your own, or simply run install_dispatcher.ps1 instead, which
     builds this task from scratch with the correct values. -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>COMPUTER\WindowsUser</Author>
    <Description>Claude reminders: plans the day's spoken reminders</Description>
    <URI>\ClaudeReminder_Dispatch</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-0000000000-0000000000-0000000000-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <LogonTrigger>
      <UserId>COMPUTER\WindowsUser</UserId>
    </LogonTrigger>
    <CalendarTrigger>
      <StartBoundary>2026-09-15T06:30:00+02:00</StartBoundary>
      <Repetition>
        <Interval>PT30M</Interval>
        <Duration>PT2H</Duration>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "C:\Users\WindowsUser\.claude\reminders\dispatch.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
